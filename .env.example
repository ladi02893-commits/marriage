# InsForge server connection. Never expose the admin key to browser code.
INSFORGE_URL=https://your-project.region.insforge.app
INSFORGE_API_KEY=replace-with-server-admin-key

# Only required if browser-side InsForge features are intentionally enabled.
NEXT_PUBLIC_INSFORGE_URL=https://your-project.region.insforge.app
NEXT_PUBLIC_INSFORGE_ANON_KEY=replace-with-anonymous-key

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Generate a unique value with at least 32 random characters.
JWT_SECRET=replace-with-a-long-random-secret
